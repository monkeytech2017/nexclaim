# ========================================
# NexClaim — Environment Variables
# Copy ไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# ห้าม commit .env เด็ดขาด
# ========================================

# --- NexClaim Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexclaim
DB_USER=nexclaim
DB_PASS=

# --- HIS Database (read-only) ---
HIS_DB_HOST=
HIS_DB_PORT=3306
HIS_DB_NAME=
HIS_DB_USER=
HIS_DB_PASS=

# --- Financial Data Hub (FDH) ---
FDH_BASE_URL=https://fdh.moph.go.th
FDH_USERNAME=
FDH_PASSWORD=
FDH_HCODE=XXXXX

# --- SSO / CHI ---
CHI_BASE_URL=https://cs8.chi.or.th
CHI_USERNAME=
CHI_PASSWORD=

# --- Hospital Info ---
HOSPITAL_NAME=
HOSPITAL_HCODE=
HOSPITAL_CHANGWAT=

# --- App ---
PORT=8080
ENV=development
LOG_LEVEL=info

# --- Frontend (copy to frontend/.env.local) ---
# Paste the key emitted by `nexclaim auth create-admin` (or a hospital key).
# Leave blank while AUTH_ENABLED=false on the backend.
NEXT_PUBLIC_API_KEY=
